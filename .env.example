# ===========================================================================
# SmartReco — environment template
# Copy to `.env` and fill in real values.  `.env` is gitignored — NEVER commit it.
#   cp .env.example .env
# ===========================================================================

# --- Mesh API (MANDATORY — all LLM/embedding calls route through here) -----
MESH_API_KEY=rsk_your_key_here
MESH_BASE_URL=https://api.meshapi.ai/v1

# Model routing (any Mesh-hosted model id works)
MESH_MODEL_REASONING=openai/gpt-4o                  # structured reasoning nodes
MESH_MODEL_WRITER=anthropic/claude-3-5-sonnet       # persuasion narrative
MESH_MODEL_GRADER=openai/gpt-4o-mini                # fast/cheap relevance grading
MESH_EMBEDDING_MODEL=openai/text-embedding-3-small  # embeddings
MESH_EMBEDDING_DIM=1536
MESH_MAX_RETRIES=3
MESH_TIMEOUT_SECONDS=60

# --- Hackathon -------------------------------------------------------------
SUBMISSION_TOKEN=your_token_here

# --- Database --------------------------------------------------------------
DATABASE_URL=postgresql+psycopg2://smartreco:smartreco@localhost:5432/smartreco
# SQLite fallback for local dev (no Postgres needed):
# DATABASE_URL=sqlite:///./smartreco.db
SQL_ECHO=false

# --- Vector DB (Qdrant) ----------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=smartreco_products
VECTOR_SEARCH_TOP_K=12

# --- Auth ------------------------------------------------------------------
SECRET_KEY=change-me-to-a-random-string-of-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Agent behaviour -------------------------------------------------------
AGENT_EVENT_TRIGGER_INTERVAL=10        # run agent every Nth new event
AGENT_STALE_HOURS=2                    # recommendation considered stale after N hours
AGENT_STALE_MIN_EVENTS=5               # ...and at least N new events since then
AGENT_MAX_RETRIEVAL_RETRIES=2          # retrieval_refiner loop budget
AGENT_MIN_RELEVANT_PRODUCTS=3          # below this we refine the query
AGENT_RECENT_EVENT_WINDOW=60           # events fed to activity_analyzer
AGENT_FINAL_PRODUCT_COUNT=6            # products in a recommendation
AGENT_LOCK_TTL_SECONDS=300             # duplicate-run guard TTL

# --- LangSmith observability (BONUS 3) -------------------------------------
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_key
LANGSMITH_PROJECT=smartreco-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- Email digest (BONUS 2) ------------------------------------------------
EMAIL_ENABLED=true
EMAIL_BACKEND=console                  # console | sendgrid | smtp
SENDGRID_API_KEY=your_sendgrid_key
DIGEST_FROM_EMAIL=noreply@nexora.ai
DIGEST_FROM_NAME=Nexora
DIGEST_SCHEDULE_HOUR=18
DIGEST_SCHEDULE_MINUTE=0
DIGEST_MIN_EVENTS_TODAY=5
DIGEST_PRODUCT_COUNT=3

# SMTP (only when EMAIL_BACKEND=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_gmail_address@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_USE_TLS=true

# --- Telegram delivery (BONUS 2b — optional) -------------------------------
TELEGRAM_BOT_TOKEN=

# --- Redis -----------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
# Leave REDIS_URL empty to transparently fall back to an in-process cache.

# --- Scheduler -------------------------------------------------------------
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=UTC

# --- App -------------------------------------------------------------------
APP_NAME=SmartReco
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
BASE_URL=http://localhost:8000
